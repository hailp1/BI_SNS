# ==============================================================================
# CJ FOODS ENTERPRISE - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in strong, unique secrets before deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SECURITY
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
CORS_ORIGINS=http://localhost:8090

# ------------------------------------------------------------------------------
# 2. DATABASE & CACHE (REQUIRED)
# ------------------------------------------------------------------------------
POSTGRES_DB=cj_enterprise_db
POSTGRES_USER=cj_sec_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# ------------------------------------------------------------------------------
# 3. JWT & DATA PAYLOADS (REQUIRED)
# ------------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_AT_LEAST_64_HEX_CHARS_RANDOM_SECRET
JWT_EXPIRES_IN=8h
DATA_PAYLOADS_DIR=/app/data_payloads
PAYLOAD_KEY=CHANGE_ME_64_HEX_CHARS_PAYLOAD_DECRYPTION_KEY

# ------------------------------------------------------------------------------
# 4. CẤU HÌNH MÁY CHỦ EMAIL SMTP (CHỌN 1 TRONG 3 TRƯỜNG HỢP BÊN DƯỚI)
# ------------------------------------------------------------------------------

# TRƯỜNG HỢP A: SỬ DỤNG MICROSOFT 365 / OFFICE 365 (Phổ biến tại các Tập đoàn FMCG)
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=it-security@cjfoods.com.vn
# SMTP_PASS=MatKhauHoacAppPassword
# SMTP_FROM="CJ Foods SNS Security" <it-security@cjfoods.com.vn>

# TRƯỜNG HỢP B: SỬ DỤNG GMAIL HOẶC GOOGLE WORKSPACE (@cj.net / @cjfoods.com.vn)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=xxxx yyyy zzzz wwww   # Mật khẩu ứng dụng 16 ký tự của Google
# SMTP_FROM="CJ Foods SNS Security" <your_email@gmail.com>

# TRƯỜNG HỢP C: SỬ DỤNG MÁY CHỦ MAIL RIÊNG NỘI BỘ CJ (On-Premise Exchange Server)
# SMTP_HOST=mail.cjfoods.com.vn
# SMTP_PORT=25
# SMTP_SECURE=false
# SMTP_TLS_REJECT_UNAUTHORIZED=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="CJ Foods SNS System" <no-reply@cjfoods.com.vn>

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
